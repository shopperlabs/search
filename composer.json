{
  "name": "shopper/search",
  "description": "Ecommerce search with facets for Shopper, powered by Laravel Scout",
  "license": "MIT",
  "keywords": [
    "shopper",
    "laravel",
    "shopper-addon",
    "e-commerce",
    "search",
    "typesense",
    "facets"
  ],
  "homepage": "https://github.com/shopperlabs/search",
  "support": {
    "issues": "https://github.com/shopperlabs/search/issues",
    "source": "https://github.com/shopperlabs/search"
  },
  "authors": [
    {
      "name": "Shopper",
      "homepage": "https://shopperlabs.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.8.2",
    "http-interop/http-factory-guzzle": "^1.2",
    "illuminate/console": "^12.68|^13.27",
    "illuminate/contracts": "^12.68|^13.27",
    "illuminate/database": "^12.68|^13.27",
    "illuminate/filesystem": "^12.68|^13.27",
    "illuminate/http": "^12.68|^13.27",
    "illuminate/pagination": "^12.68|^13.27",
    "illuminate/routing": "^12.68|^13.27",
    "illuminate/support": "^12.68|^13.27",
    "illuminate/validation": "^12.68|^13.27",
    "laravel/prompts": "^0.3.16",
    "laravel/scout": "^10.13",
    "shopper/framework": "^3.0.0-rc.4",
    "shopper/http": "^3.0.0-rc.4",
    "spatie/laravel-data": "^4.9",
    "spatie/laravel-package-tools": "^1.15",
    "typesense/typesense-php": "^4.9|^5.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.10",
    "laravel/pint": "^1.29",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-livewire": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Search\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shopper\\Search\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "pint",
    "test": "pest --colors=always --parallel",
    "test:lint": "pint --test",
    "test:types": "phpstan analyse --ansi --memory-limit=-1"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Search\\SearchServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
